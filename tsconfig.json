{
  "compilerOptions": {
    "target":                     "ES2020",
    "module":                     "NodeNext",
    "moduleResolution":           "NodeNext",
    "lib":                        ["ES2020", "DOM"],
    "strict":                     true,
    "noUncheckedIndexedAccess":   true,
    "forceConsistentCasingInFileNames": true,
    "declaration":                true,
    "declarationMap":             true,
    "sourceMap":                  true,
    "outDir":                     "dist",
    "rootDir":                    "src",
    "skipLibCheck":               true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
