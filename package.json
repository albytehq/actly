{
  "name": "actly",
  "version": "1.3.0",
  "description": "A typed reliability kernel for async execution.",
  "keywords": [
    "reliability",
    "retry",
    "timeout",
    "dedupe",
    "cache",
    "async",
    "backoff",
    "abort",
    "single-flight",
    "resilience",
    "jitter",
    "circuit-breaker",
    "bulkhead",
    "rate-limit",
    "hedge"
  ],
  "license": "MIT",
  "author": "albytehq",
  "homepage": "https://github.com/albytehq/actly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albytehq/actly.git"
  },
  "bugs": {
    "url": "https://github.com/albytehq/actly/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint src --ext .ts --ignore-pattern 'src/__tests__/**'",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/index.mjs",
    "bench:compare": "node bench/compare-cockatiel.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.19.0",
    "globals": "^17.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^1.6.0"
  }
}
