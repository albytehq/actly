{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/cjs",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true,
    "stripInternal": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/__tests__", "src/state"]
}
