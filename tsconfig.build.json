{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "removeComments": true,
    "stripInternal": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/__tests__", "src/state"]
}
